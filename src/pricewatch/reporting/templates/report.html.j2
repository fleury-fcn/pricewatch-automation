<!doctype html>
<html lang="{{ t.html_lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ data.title }} — {{ data.generated_at | date }}</title>
<meta name="description" content="{{ t.meta_description.format(date=(data.generated_at | date), n=s.n_products) }}">
<style>
  :root {
    color-scheme: light;
    --page: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
    --grid: #e1e0d9; --axis: #c3c2b7; --accent: #2a78d6; --tint: #f4f3ef;
    --good: #006300; --critical: #d03b3b; --ring: rgba(11,11,11,.10);
    --font: system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--page); color: var(--ink); font: 15px/1.55 var(--font); }
  main { max-width: 1080px; margin: 0 auto; padding: 32px 16px 64px; }
  .topbar { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  header h1 { font-size: 28px; line-height: 1.2; margin: 0 0 4px; }
  .meta { color: var(--muted); font-size: 13px; }
  .lang-switch { font-size: 14px; color: var(--accent); text-decoration: none; border: 1px solid var(--ring);
                 background: var(--surface); border-radius: 16px; padding: 4px 12px; white-space: nowrap; }
  .lang-switch:hover { border-color: var(--accent); }
  .note { background: var(--tint); border-left: 3px solid var(--accent); padding: 10px 14px;
          margin: 16px 0; color: var(--ink-2); font-size: 14px; border-radius: 4px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin: 24px 0; }
  .tile { background: var(--surface); border: 1px solid var(--ring); border-radius: 8px; padding: 14px 16px; }
  .tile .value { font-size: 28px; font-weight: 600; }
  .tile .label { color: var(--ink-2); font-size: 13px; }
  section { margin-top: 32px; }
  h2 { font-size: 19px; margin: 0 0 12px; }
  .card { background: var(--surface); border: 1px solid var(--ring); border-radius: 8px; padding: 12px; margin-bottom: 16px; overflow: hidden; }
  ul.highlights { padding-left: 20px; color: var(--ink-2); }
  ul.highlights li { margin: 4px 0; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
  th { text-align: left; color: var(--ink-2); font-weight: 600; border-bottom: 1px solid var(--axis); padding: 8px; white-space: nowrap; }
  td { border-bottom: 1px solid var(--grid); padding: 7px 8px; color: var(--ink-2); vertical-align: top; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td a { color: var(--ink); text-decoration-color: var(--axis); }
  .badge { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 10px; background: var(--tint); color: var(--ink); white-space: nowrap; }
  .badge.anomaly::before { content: "⚠ "; color: var(--critical); }
  .badge.price_drop::before { content: "↓ "; color: var(--accent); }
  .badge.target_reached::before { content: "✓ "; color: var(--good); }
  details summary { cursor: pointer; color: var(--ink-2); margin: 8px 0; }
  footer { margin-top: 48px; color: var(--muted); font-size: 13px; }
</style>
</head>
<body>
<main>
<header>
  <div class="topbar">
    <div>
      <h1>{{ data.title }}</h1>
      <div class="meta">{{ t.generated_on.format(date=(data.generated_at | date(true))) }} · PriceWatch v{{ version }}
        {% if s.period_start %} · {{ t.period.format(start=(s.period_start | date), end=(s.period_end | date)) }}{% endif %}</div>
    </div>
    {% for code, href in alternates.items() %}
    <a class="lang-switch" data-lang="{{ code }}" hreflang="{{ code }}" href="{{ href }}">{{ "English version" if code == "en" else "Version française" }}</a>
    {% endfor %}
  </div>
  {% if data.simulated %}
  <p class="note"><strong>{{ t.demo_title }}</strong> {{ t.demo_body }}</p>
  {% endif %}
</header>

<div class="tiles">
  <div class="tile"><div class="value">{{ s.n_products | num(0) }}</div><div class="label">{{ t.kpi_products }}</div></div>
  <div class="tile"><div class="value">{{ s.n_significant_drops | num(0) }}</div><div class="label">{{ t.kpi_drops.format(threshold=(data.significant_drop_pct | num(0))) }}</div></div>
  <div class="tile"><div class="value">{{ s.n_anomalies | num(0) }}</div><div class="label">{{ t.kpi_anomalies }}</div></div>
  <div class="tile"><div class="value">{{ s.avg_change_pct | pct }}</div><div class="label">{{ t.kpi_avg_gap }}</div></div>
  <div class="tile"><div class="value">{{ data.alerts | length }}</div><div class="label">{{ t.kpi_alerts }}</div></div>
</div>

<section>
  <h2>{{ t.section_summary }}</h2>
  <ul class="highlights">{% for point in data.highlights %}<li>{{ point }}</li>{% endfor %}</ul>
</section>

{% if figures.category %}<section><div class="card">{{ figures.category | safe }}</div></section>{% endif %}

<section>
  <h2>{{ t.section_drops }}</h2>
  {% if figures.drops %}<div class="card">{{ figures.drops | safe }}</div>{% endif %}
  {% if data.drops.empty %}<p>{{ t.no_drops }}</p>{% else %}
  <div class="card table-wrap"><table>
    <thead><tr><th>{{ t.col_product }}</th><th>{{ t.col_category }}</th><th class="num">{{ t.col_price }}</th><th class="num">{{ t.col_recent_avg }}</th><th class="num">{{ t.col_gap }}</th><th class="num">{{ t.col_vs_prev }}</th><th>{{ t.col_trend }}</th></tr></thead>
    <tbody>{% for r in data.drops.itertuples() %}
      <tr><td><a href="{{ r.url }}">{{ r.title }}</a></td><td>{{ r.category or "—" }}</td>
        <td class="num">{{ r.last_price | money(r.currency) }}</td><td class="num">{{ r.reference_price | money(r.currency) }}</td>
        <td class="num">{{ r.drop_pct | pct }}</td><td class="num">{{ r.change_pct | pct }}</td><td>{{ r.trend | trend }}</td></tr>
    {% endfor %}</tbody>
  </table></div>{% endif %}
  {% if figures.history %}<div class="card">{{ figures.history | safe }}</div>{% endif %}
</section>

{% if figures.distribution %}<section><div class="card">{{ figures.distribution | safe }}</div></section>{% endif %}

<section>
  <h2>{{ t.section_alerts }}</h2>
  {% if data.alerts.empty %}<p>{{ t.no_alerts }}</p>{% else %}
  <div class="card table-wrap"><table>
    <thead><tr><th>{{ t.col_type }}</th><th>{{ t.col_message }}</th><th class="num">{{ t.col_price }}</th><th>{{ t.col_date }}</th></tr></thead>
    <tbody>{% for a in data.alerts.itertuples() %}
      <tr><td><span class="badge {{ a.kind }}">{{ a.kind | kind_label }}</span></td><td>{{ a.message }}</td>
        <td class="num">{{ a.price | money(a.currency) }}</td><td>{{ a.created_at | date }}</td></tr>
    {% endfor %}</tbody>
  </table></div>{% endif %}
</section>

{% if not data.rises.empty %}
<section>
  <h2>{{ t.section_rises }}</h2>
  <div class="card table-wrap"><table>
    <thead><tr><th>{{ t.col_product }}</th><th class="num">{{ t.col_price }}</th><th class="num">{{ t.col_recent_avg }}</th><th class="num">{{ t.col_gap }}</th></tr></thead>
    <tbody>{% for r in data.rises.itertuples() %}
      <tr><td><a href="{{ r.url }}">{{ r.title }}</a></td><td class="num">{{ r.last_price | money(r.currency) }}</td>
        <td class="num">{{ r.reference_price | money(r.currency) }}</td><td class="num">{{ r.drop_pct | pct }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
</section>
{% endif %}

<section>
  <h2>{{ t.section_products }}</h2>
  <details><summary>{{ t.show_table.format(n=(products | length)) }}</summary>
  <div class="card table-wrap"><table>
    <thead><tr><th>{{ t.col_product }}</th><th>{{ t.col_category }}</th><th class="num">{{ t.col_price }}</th><th class="num">{{ t.col_min }}</th><th class="num">{{ t.col_max }}</th><th class="num">{{ t.col_gap }}</th><th class="num">{{ t.col_zscore }}</th><th>{{ t.col_trend }}</th><th class="num">{{ t.col_obs }}</th></tr></thead>
    <tbody>{% for r in products.itertuples() %}
      <tr><td><a href="{{ r.url }}">{{ r.title }}</a></td><td>{{ r.category or "—" }}</td>
        <td class="num">{{ r.last_price | money(r.currency) }}</td><td class="num">{{ r.min_price | num }}</td><td class="num">{{ r.max_price | num }}</td>
        <td class="num">{{ r.drop_pct | pct }}</td><td class="num">{{ r.zscore | num(1) }}</td><td>{{ r.trend | trend }}</td><td class="num">{{ r.n_obs }}</td></tr>
    {% endfor %}</tbody>
  </table></div></details>
</section>

<section>
  <h2>{{ t.section_method }}</h2>
  <p style="color: var(--ink-2)">{{ t.method }}</p>
</section>

<footer>PriceWatch — <a href="https://github.com/fleury-fcn/pricewatch-automation">{{ t.footer_source }}</a> · Fleury Niyokwizera · {{ t.footer_license }}</footer>
</main>
</body>
</html>
